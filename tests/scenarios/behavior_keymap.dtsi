#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <behaviors.dtsi>
#include <behaviors/anti_idle.dtsi>
#include <dt-bindings/anti_idle.h>

/ {
    anti_idle: anti_idle {
        compatible = "zmk,anti-idle-generic";
        interval-ms = <200>;
        bindings = <&kp F24>;
        tap_ms = <10>;
        wait_ms = <10>;
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp A &kp B
                &ai AI_TOG &none
            >;
        };
    };
};
